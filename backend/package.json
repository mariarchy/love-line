{
  "name": "love-line-backend",
  "version": "1.0.0",
  "description": "Twilio-based phone matching service for Valentine's Day blind dates",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "db:ensure": "ts-node scripts/ensure-db.ts",
    "dev": "pnpm run db:ensure && sh -c \"ngrok http 3000 --log=stdout >/tmp/ngrok-dev.log 2>&1 & ts-node-dev --respawn --transpile-only src/index.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "ts-node src/utils/validate-participants.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js",
    "db:reset": "ts-node src/db/reset.ts"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.9.0",
    "pnpm": "10.28.1"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@sentry/node": "^10.38.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "kysely": "^0.28.11",
    "pg": "^8.13.1",
    "twilio": "^5.12.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}