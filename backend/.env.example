# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14155559999

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Configuration
MAX_WAIT_TIME_MINUTES=20

# Database (SQLite file path; production often uses a mounted volume path)
# PARTICIPANTS_DB=/app/data/participants.db

# Seed data: local file path, or production-only JSON string (never commit real data)
# SEED_FILE=data/participants.json
# SEED_DATA={"optional":"json string for production - set in host secrets"}

# Webhook Base URL (required in production; Twilio calls this for US/UK)
WEBHOOK_BASE_URL=https://your-app.up.railway.app

