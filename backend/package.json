{
  "name": "love-line-backend",
  "version": "1.0.0",
  "description": "Twilio-based phone matching service for Valentine's Day blind dates",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "type-check": "tsc --noEmit",
    "validate": "ts-node src/utils/validate-participants.ts",
    "db:seed": "ts-node src/utils/seed-db.ts",
    "db:reset": "rm -f data/participants.db && npm run db:seed"
  },
  "keywords": ["twilio", "phone", "dating", "valentines"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "twilio": "^4.19.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
