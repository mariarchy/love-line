# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14155559999

# Server Configuration
PORT=3000
NODE_ENV=development

# Application Configuration
MAX_WAIT_TIME_MINUTES=20

# Database (required). Keep POSTGRES_USER/POSTGRES_PASSWORD in sync with DATABASE_URL and docker-compose.
# Railway: set DATABASE_URL from the Postgres plugin (Variables tab); set POSTGRES_USER and POSTGRES_PASSWORD to match.
DATABASE_URL=postgresql://loveline:loveline@localhost:5432/loveline
POSTGRES_USER=loveline
POSTGRES_PASSWORD=loveline

# Seed data: local file path, or production-only JSON string (never commit real data)
# SEED_FILE=data/participants.json
# SEED_DATA={"optional":"json string for production - set in host secrets"}

# Webhook Base URL (required in production; Twilio calls this for US/UK)
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# When set, errors are sent to Sentry; configure Slack/email/PagerDuty in Sentry project settings.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

