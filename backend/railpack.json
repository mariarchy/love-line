{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": ["build-essential", "python3"],
  "steps": {
    "install": {
      "inputs": [{ "local": true, "include": ["."] }],
      "commands": ["pnpm install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["...", "pnpm run build"]
    }
  },
  "deploy": {
    "startCommand": "pnpm db:seed:prod && pnpm start"
  }
}
